#!/bin/sh
# Flathub, from a release that bin/release has tagged and pushed.
#
#   bin/flathub manifest [tag]  Write and lint build/flathub/io.github.kjlape.Flip.yml,
#                               which builds the tag from GitHub instead of this checkout.
#   bin/flathub test [tag]      Build and install that manifest the way Flathub will,
#                               then lint the result.
#   bin/flathub submit [tag]    First time only: open the pull request that asks
#                               Flathub to add Flip (against flathub/flathub, new-pr).
#   bin/flathub update [tag]    Every release after Flip is on Flathub: open a pull
#                               request that moves flathub/io.github.kjlape.Flip to the tag.
#
# The tag defaults to the newest v* tag. submit and update ask before
# touching GitHub; --dry-run shows what they would do and stops there.
set -eu
. "$(dirname -- "$0")/lib.sh"

COMMAND="${1:-}"
[ $# -gt 0 ] && shift
DRY_RUN=0
TAG=""
for argument in "$@"; do
  case "$argument" in
    --dry-run) DRY_RUN=1 ;;
    v*) TAG="$argument" ;;
    *) die "unknown argument $argument" ;;
  esac
done
cd "$ROOT"
[ -n "$TAG" ] || TAG="$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null)" \
  || die "no release tag yet. Make one with bin/release <version>."
git rev-parse -q --verify "refs/tags/$TAG" >/dev/null || die "there's no tag $TAG here."
COMMIT="$(git rev-parse "$TAG^{commit}")"
OUT="$ROOT/build/flathub"
MANIFEST="$OUT/$APP.yml"

# Flathub builds from the public repository, so the tag must be there, and
# must be the same commit as here.
check_pushed() {
  remote="$(git ls-remote "$GIT_URL" "refs/tags/$TAG^{}" | cut -f1)"
  [ -n "$remote" ] || die "$TAG isn't on $GIT_URL yet. Publish it with: bin/release ${TAG#v} --publish"
  [ "$remote" = "$COMMIT" ] || die "$TAG on $GIT_URL is $remote, but here it's $COMMIT."
}

write_manifest() {
  check_pushed
  mkdir -p "$OUT"
  GIT_URL="$GIT_URL" TAG="$TAG" COMMIT="$COMMIT" python3 - "$ROOT/flatpak/$APP.yml" "$MANIFEST" <<'PY'
import os, re, sys
source, target = sys.argv[1], sys.argv[2]
with open(source) as f:
    text = f.read()
git = (f"      - type: git\n"
       f"        url: {os.environ['GIT_URL']}\n"
       f"        tag: {os.environ['TAG']}\n"
       f"        commit: {os.environ['COMMIT']}\n")
pattern = r"      # Builds this checkout\..*?# END local source\n"
new, n = re.subn(pattern, git, text, flags=re.S)
if n != 1:
    sys.exit("error: couldn't find the local source markers in " + source)
new = new.replace("# Flatpak manifest for Flip. Build and install it with bin/flatpak.",
                  "# Flatpak manifest for Flip, built from its release on GitHub.")
with open(target, "w") as f:
    f.write(new)
PY
  echo "Wrote $MANIFEST for $TAG ($COMMIT)."
}

# The Flathub linter. Unreachable URLs are only expected while rehearsing
# against a local repository.
lint_manifest() {
  setup_builder
  if $LINT manifest "$MANIFEST"; then
    echo "The Flathub linter passed the manifest."
  elif [ "$DRY_RUN" = 1 ]; then
    echo "warning: the Flathub linter found problems with $MANIFEST (above)." >&2
  else
    die "the Flathub linter found problems with $MANIFEST (above)."
  fi
}

# A fresh clone of a GitHub repository in build/flathub, on a new branch.
checkout() {
  repository="$1" base="$2" branch="$3" directory="$4"
  rm -rf -- "$directory"
  gh repo clone "$repository" "$directory" -- --branch "$base" --single-branch --quiet
  git -C "$directory" checkout -q -b "$branch"
}

case "$COMMAND" in
  manifest)
    write_manifest
    lint_manifest
    ;;

  test)
    write_manifest
    setup_builder
    cd "$OUT"
    # Mirroring the screenshots into the build, as Flathub's own build does,
    # lets the linter check them.
    $BUILDER --user --force-clean --repo=repo --install \
      --mirror-screenshots-url=https://dl.flathub.org/media --compose-url-policy=full \
      --state-dir="${FLIP_STATE_DIR:-$ROOT/.flatpak-builder}" build-dir "$APP.yml"
    $LINT manifest "$APP.yml" || echo "warning: the linter found problems with the manifest (above)." >&2
    $LINT repo repo || echo "warning: the linter found problems with the build (above)." >&2
    echo "Built and installed $APP from $TAG. Try it with: flatpak run $APP"
    ;;

  submit)
    need gh "Install github-cli and run: gh auth login"
    write_manifest
    lint_manifest
    user="$(gh api user --jq .login)"
    branch="add-$APP"
    if [ "$DRY_RUN" = 1 ]; then
      echo "Would fork flathub/flathub to $user/flathub, branch $branch from flathub/flathub new-pr,"
      echo "commit $APP.yml, push it to the fork, and open a pull request against flathub/flathub new-pr."
      exit 0
    fi
    confirm "Fork flathub/flathub as $user and open a pull request adding $APP at $TAG?"
    gh repo fork flathub/flathub --clone=false >/dev/null 2>&1 || true
    work="$OUT/submission"
    # Start from Flathub's own new-pr, which a fork's copy may lag behind,
    # and push the branch to the fork.
    checkout flathub/flathub new-pr "$branch" "$work"
    git -C "$work" remote add fork "https://github.com/$user/flathub.git"
    cp "$MANIFEST" "$work/$APP.yml"
    git -C "$work" add "$APP.yml"
    git -C "$work" commit -qm "Add $APP"
    git -C "$work" push -q --force fork "$branch"
    gh pr create --repo flathub/flathub --base new-pr --head "$user:$branch" \
      --title "Add $APP" --body-file "$ROOT/flatpak/flathub-submission.md"
    ;;

  update)
    need gh "Install github-cli and run: gh auth login"
    write_manifest
    lint_manifest
    branch="update-$TAG"
    if [ "$DRY_RUN" = 1 ]; then
      echo "Would branch $branch from flathub/$APP master, replace $APP.yml with the $TAG"
      echo "manifest, push, and open a pull request against flathub/$APP master."
      exit 0
    fi
    confirm "Open a pull request moving flathub/$APP to $TAG?"
    work="$OUT/update"
    checkout "flathub/$APP" master "$branch" "$work"
    cp "$MANIFEST" "$work/$APP.yml"
    git -C "$work" add "$APP.yml"
    git -C "$work" diff --cached --quiet && die "flathub/$APP already builds $TAG."
    git -C "$work" commit -qm "Update to $TAG"
    git -C "$work" push -q origin "$branch"
    gh pr create --repo "flathub/$APP" --base master --head "$branch" \
      --title "Update to $TAG" --body "Updates Flip to $TAG: https://github.com/$GITHUB_REPO/releases/tag/$TAG"
    ;;

  *)
    # The comment at the top of this file.
    sed -n '2,/^[^#]/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
