pkgname=lape-flip
pkgver=0.1.1
pkgrel=1
pkgdesc='Draw frame by frame and play it back as an animation'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'ffmpeg')
makedepends=('gcc' 'make')
# Renamed from flip; replaces moves machines with the old package over.
conflicts=('flip')
replaces=('flip')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/flip "$pkgdir/usr/bin/flip"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/flip.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/flip.svg"
  install -Dm644 "$startdir/flip.desktop" "$pkgdir/usr/share/applications/flip.desktop"
  install -Dm644 "$startdir/flip.xml" "$pkgdir/usr/share/mime/packages/flip.xml"
}
